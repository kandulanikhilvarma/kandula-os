# Copy to .env.local and fill in. Never commit .env.local.
# Real values also go in the Vercel dashboard. Full walkthrough: docs/DEPLOY.md
# Verify with: python scripts/preflight.py

# Server credential — the full service-account JSON collapsed to ONE line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Browser sign-in config — not a secret, but must be valid JSON on one line.
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# Who may sign in. Comma-separated. Anyone else gets a 403.
ALLOWED_EMAILS=you@example.com

# Shared secret for POST /api/sync. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SYNC_SECRET=generate-a-long-random-string

# Where sync_state.py POSTs. Set after the first Vercel deploy.
SYNC_URL=https://your-app.vercel.app
